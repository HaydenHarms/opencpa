{
  "name": "@opencpa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no api tests yet\"",
    "db:migrate:local": "wrangler d1 migrations apply opencpa --local",
    "db:migrate:remote": "wrangler d1 migrations apply opencpa --remote"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opencpa/engine": "workspace:*",
    "@opencpa/schema": "workspace:*",
    "hono": "^4.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.80.0"
  }
}
